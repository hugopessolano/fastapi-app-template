APP_NAME="FastAPI Template"
ENVIRONMENT="development"
DATABASE_URL="sqlite:///./app/app.db"
LOGS_DB_PATH="app/mi_aplicacion_logs.db"
EXTERNAL_DB_URL=""

SECRET_KEY="replace-this-value"
ACCESS_TOKEN_EXPIRE_MINUTES=720
TOKEN_ALGORITHM="HS256"
AUTH_MODE="built_in" # options: built_in, disabled, custom
TENANTS_ENABLED=true
RATE_LIMIT_DEFAULT_REQUESTS=60
RATE_LIMIT_DEFAULT_WINDOW_SECONDS=60
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=0.2
RETRY_MAX_DELAY_SECONDS=2.0
RETRY_JITTER_SECONDS=0.1
CACHE_ENABLED=false
CACHE_DEFAULT_TTL_SECONDS=60

AUTO_BUILD_PERMISSIONS=true
ENABLE_SEED_DATA=true
SEED_CHECK_EXISTING_USERS=true
